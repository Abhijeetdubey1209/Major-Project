# Production environment variables for Vercel deployment
# Replace this URL with your actual backend URL

# Option 1: Cloudflare tunnel URL (temporary, changes each restart)
# VITE_API_URL=https://your-tunnel-url.trycloudflare.com

# Option 2: Render/Railway/Heroku backend URL (recommended for production)
# VITE_API_URL=https://your-backend.onrender.com

# Option 3: Your own server
# VITE_API_URL=https://api.yourdomain.com

VITE_API_URL=https://your-backend-url-here.com
